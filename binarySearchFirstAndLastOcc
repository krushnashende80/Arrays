public class binarySearchFirstAndLastOcc {

    public static void main(String[] args) {
        int arr[] = { 2, 2, 5, 6, 8, 9, 9 };

        int firstTarget = 2;
        int start = 0;
        int end = arr.length - 1;
        int lastAccurance = -1;
        int firstAccurance = -1;

        // first Occurrence
        while (start <= end) {
            int mid = (start + end) / 2;

            if (arr[mid] == firstTarget) {
                firstAccurance = mid;
                end = mid - 1;
            } else if (arr[mid] < firstTarget) { // FIXED
                start = mid + 1;
            } else {
                end = mid - 1;
            }
        }
        System.out.println(firstAccurance);

        // RESET start & end (IMPORTANT FIX)
        start = 0;
        end = arr.length - 1;

        // last Occurrence
        int lastTarget = 9;
        while (start <= end) {
            int mid = (start + end) / 2;

            if (arr[mid] == lastTarget) {
                lastAccurance = mid;
                start = mid + 1;
            } else if (arr[mid] < lastTarget) { // FIXED
                start = mid + 1;
            } else {
                end = mid - 1;
            }
        }
        System.out.println(lastAccurance);
    }
}
